---
import { Image } from '@unpic/astro';
import ArrowDownIcon from '/src/assets/arrow-down.svg?raw';
import { siteData } from '../../data/site-data';
import heroImage from '../../assets/hero.jpg';
---

<div class="hero">
  <Image
    src={heroImage}
    alt="hero banner"
    width={2000}
    height={1200}
    loading="eager"
    fetchpriority="high"
    draggable="false"
  />
  <a href={siteData.heroIcon.href} class="hero__skip-link flow">
    <span class="hero__skip-link-icon"><div class="hero__skip-link-icon__inner" set:html={ArrowDownIcon}></div></span>
    <span class="hero__skip-link-label">{siteData.heroIcon.label}</span>
  </a>
</div>