---
import { Image } from "@unpic/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from '../components/card/ProductCard.astro';
import Hero from '../components/hero/Hero.astro'
import heroImage from '../assets/tents-header.webp';

import { sanityClient, urlFor } from '../lib/sanity';
import { formatProductPrice } from '../lib/currency';

const products = await sanityClient.fetch<any[]>(`
  *[_type == "product" && category == "backpack"] | order(_createdAt desc) {
    _id,
    title,
    slug,
    mainImage,
    price,
    description,
    weight,
    dimensions,
    capacity,
    inStock,
    featured
  }
`);
---

<BaseLayout title="Products" description="Browse all available products">
  <div class="product-container">
    <Hero image={heroImage} height={600} label="Ultralight Backpacks" />
  
    <div class="wrapper region flow"> 
      <div class="grid-auto">
        {products.map((product: any, i) => {
          return (<ProductCard href={`/product/${product.slug.current}`} label={product.title}>
            <div class="image-container">
              <Image
                src={urlFor(product.mainImage).width(800).height(800).url()}
                alt={product.title}
                width={800}
                height={800}
                loading={i < 4 ? "eager" : null}
                fetchpriority={i < 4 ? "high" : undefined}
              />
            </div>
            <div class="flow">
              <h4>{product.title}</h4>
              <p>{product.capacity}</p>
              <p>{formatProductPrice(product.price)}</p>
            </div>
          </ProductCard>)
        })}
      </div>
    </div>
  </div>
</BaseLayout>