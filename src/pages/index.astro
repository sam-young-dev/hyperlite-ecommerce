---
import { Image } from "@unpic/astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/masthead/Masthead.astro';
import Hero from '../components/hero/Hero.astro';
import Closer from '../components/closer/Closer.astro';
import Card from '../components/card/Card.astro';

import { sanityClient, urlFor } from '../lib/sanity';
import type { Painting } from '../types/painting';

const featuredPaintings = await sanityClient. fetch<Painting[]>(`
  *[_type == "painting" && featured == true && sold == false] | order(_createdAt desc) [0... 3] {
    _id,
    title,
    slug,
    mainImage,
    price,
    medium
  }
`);
---

<BaseLayout title="Art Gallery - Original Paintings" description="Art gallery home page">
	<div class="region flow">
		<div class="wrapper">
			<Masthead />
		</div>
		<!-- <Hero /> -->
	</div>
	
	<div class="region wrapper flow" id="content">
		{featuredPaintings.length > 0 && (
			<h2>Featured Works</h2>
			<div class="grid-auto">
				{featuredPaintings.map((painting: Painting) => (
					<Card href={`/product/${painting.slug.current}`} label={painting.title}>
						<Image
							src={urlFor(painting.mainImage).width(800).height(800).url()}
							alt={painting.title}
							loading="lazy"
							width={800}
							height={800}
						/>
						<h3>{painting.title}</h3>
						<p class="medium">{painting.medium}</p>
						<p class="price">${painting.price}</p>
					</Card>
				))}
			</div>
		)}
	</div>
	
	<Closer />
</BaseLayout>
