---
import { Image } from "@unpic/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

import { sanityClient, urlFor } from '../../lib/sanity';
import type { Painting } from '../../types/painting';
import { formatProductPrice } from '../../lib/currency';

export async function getStaticPaths() {
  // const paintings = await sanityClient.fetch<Painting[]>(`
  //   *[_type == "painting"] {
  //     slug
  //   }
  // `);

  const products = await sanityClient.fetch<any[]>(`
    *[_type == "product"] {
      slug
    }
  `);
  
  return products.map((product: any) => ({
    params: { slug: product.slug.current },
  }));
}

const { slug } = Astro.params;

// const painting = await sanityClient. fetch<Painting>(
//   `*[_type == "painting" && slug. current == $slug][0] {
//     _id,
//     title,
//     slug,
//     mainImage,
//     gallery,
//     description,
//     price,
//     medium,
//     dimensions,
//     year,
//     sold,
//     stripePaymentLink
//   }`,
//   { slug }
// );

// if (!painting) {
//   return Astro.redirect('/products');
// }

const product = await sanityClient. fetch<any>(
  `*[_type == "product" && slug. current == $slug][0] {
    _id,
    title,
    slug,
    mainImage,
    gallery,
    price,
    description,
    weight,
    dimensions,
    capacity,
    inStock,
    featured,
    category
  }`,
  { slug }
);

if (!product) {
  return Astro.redirect('/');
}
---

<BaseLayout title={`${product.title} - ${product.category}`} description={product.description}>
  <div class="">
    <div class="image-section">
      <ul class="slider">
        <li data-accName="Item 1" class="slider-item">
          <Image
            src={urlFor(product.mainImage).width(1500).height(800).url()}
            alt={product.title}
            width={1500}
            height={800}
            loading="eager"
            fetchpriority="high"
          />
        </li>
        {product.gallery && product.gallery.length > 0 && product.gallery.map((image: any) => (
          <li data-accName={product.title} class="slider-item">
            <Image
              src={urlFor(image).width(1500).height(800).url()}
              alt={`${product.title} detail`}
              width={1500}
              height={800}
            />
          </li>
          ))}
      </ul>
    </div>
    
    <div class="wrapper region flow">
      <h1>{product.title}</h1>
      
      {product.description && (
        <div class="description">
          <h3>Description</h3>
          <p>{product.description}</p>
        </div>
      )}
      
      <div class="purchase-section flow">
        <p class="price">{formatProductPrice(product.price)}</p>
        
        {!product.inStock ?  (
          <button disabled class="sold-button">Sold Out</button>
        ) :
          <button
            class="button snipcart-add-item"
            data-item-id={product._id}
            data-item-price={product.price / 100}
            data-item-image={product?.mainImage ? urlFor(product?.mainImage).url() : ""}
            data-item-description={product?.description}
            data-item-name={product.title}
          >
            Add to cart
          </button>}
      </div>
    </div>
  </div>
</BaseLayout>