---
import { Image } from "@unpic/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from '../components/card/Card.astro';

import { sanityClient, urlFor } from '../lib/sanity';
import type { Painting } from '../types/painting';

const paintings = await sanityClient.fetch<Painting[]>(`
  *[_type == "painting" && sold == false] | order(_createdAt desc) {
    _id,
    title,
    slug,
    mainImage,
    price,
    medium,
    dimensions
  }
`);
---

<BaseLayout title="Gallery - All Paintings" description="Browse all available original paintings">
  <div class="region wrapper flow">
    <h1>Gallery</h1>
    
    <div class="grid-auto">
      {paintings.map((painting: Painting) => {
        return (<Card href={`/product/${painting.slug.current}`} label={painting.title}>
          <div class="image-container">
            <Image
              src={urlFor(painting.mainImage).width(800).height(800).url()}
              alt={painting.title}
              width={800}
              height={800}
            />
          </div>
          <div class="painting-info flow">
            <h2>{painting.title}</h2>
            {painting.medium && <p class="medium">{painting.medium}</p>}
            {painting.dimensions && (
              <p class="dimensions">
                {painting.dimensions.width}" x {painting.dimensions.height}"
              </p>
            )}
            <p class="price">${painting.price}</p>
          </div>
        </Card>)
      })}
    </div>
  </div>
</BaseLayout>