---
import BaseLayout from "../layouts/BaseLayout.astro";
import Products from "../components/product/Products.astro";
import heroImage from '../assets/tents-header.webp';

import { sanityClient } from '../lib/sanity';

const products = await sanityClient.fetch<any[]>(`
  *[_type == "product" && category == "tent"] | order(_createdAt desc) {
    _id,
    title,
    slug,
    mainImage,
    price,
    description,
    shortDescription,
    weight,
    dimensions,
    capacity,
    inStock,
    featured
  }
`);
---

<BaseLayout title="Products" description="Browse all available products">
  <Products heroImage={heroImage} products={products} label="Ultralight Tents"></Products>
</BaseLayout>